{
  "name": "0xAF-Re",
  "plannerProvider": "codex",
  "executorProvider": "claude",
  "researcherProvider": "codex",
  "defaultRole": "auto",
  "maxTurns": 8,
  "providers": {
    "codex": {
      "type": "cli-tmux",
      "label": "Codex CLI tmux",
      "model": "codex-cli",
      "cliCommand": "codex",
      "cliArgs": [
        "exec",
        "--skip-git-repo-check",
        "--sandbox",
        "read-only",
        "--ask-for-approval",
        "never",
        "--output-last-message",
        "{output}",
        "-"
      ],
      "cliTimeoutMs": 600000,
      "cliUnsetEnv": ["OPENAI_API_KEY", "OPENAI_CODEX_OAUTH_TOKEN"]
    },
    "claude": {
      "type": "cli-tmux",
      "label": "Claude Code tmux",
      "model": "claude-code-cli",
      "cliCommand": "claude",
      "cliArgs": ["-p", "--output-format", "text", "--permission-mode", "default"],
      "cliTimeoutMs": 600000,
      "cliUnsetEnv": ["ANTHROPIC_API_KEY", "ANTHROPIC_OAUTH_TOKEN"]
    },
    "codex-api": {
      "type": "openai-responses",
      "label": "Codex API",
      "model": "gpt-5.3-codex",
      "baseUrl": "https://api.openai.com/v1",
      "apiKeyEnv": ["OPENAI_API_KEY", "OPENAI_CODEX_OAUTH_TOKEN"],
      "reasoningEffort": "high"
    },
    "claude-api": {
      "type": "anthropic",
      "label": "Claude API Opus 4.8",
      "model": "claude-opus-4-8",
      "baseUrl": "https://api.anthropic.com",
      "apiKeyEnv": ["ANTHROPIC_API_KEY", "ANTHROPIC_OAUTH_TOKEN"],
      "maxTokens": 8192
    },
    "grok": {
      "type": "openai-responses",
      "label": "Grok Build 4.5",
      "model": "grok-4.5",
      "baseUrl": "https://api.x.ai/v1",
      "apiKeyEnv": ["XAI_API_KEY"],
      "reasoningEffort": "high",
      "maxTokens": 8192
    },
    "grok-cli": {
      "type": "cli-tmux",
      "label": "Grok Build CLI tmux",
      "model": "grok-build-cli",
      "cliCommand": "grok",
      "cliArgs": [
        "--prompt-file",
        "{prompt}",
        "--output-format",
        "plain",
        "--disable-web-search",
        "--no-memory",
        "--permission-mode",
        "dontAsk"
      ],
      "cliTimeoutMs": 600000,
      "cliPromptMaxChars": 80000,
      "cliResumeSession": true
    },
    "deepseek": {
      "type": "openai-chat",
      "label": "DeepSeek",
      "model": "deepseek-chat",
      "baseUrl": "https://api.deepseek.com/v1",
      "apiKeyEnv": ["DEEPSEEK_API_KEY"],
      "maxTokens": 8192
    },
    "glm": {
      "type": "openai-chat",
      "label": "GLM / Z.AI",
      "model": "glm-4.6",
      "baseUrl": "https://open.bigmodel.cn/api/paas/v4",
      "apiKeyEnv": ["ZAI_API_KEY", "GLM_API_KEY"],
      "maxTokens": 8192
    },
    "mock": {
      "type": "mock",
      "label": "Mock Provider",
      "model": "mock-reasoner"
    }
  },
  "mcpServers": {
    "ida": {
      "command": "python3",
      "args": ["-m", "ida_pro_mcp.server"],
      "timeoutMs": 120000,
      "disabled": true
    }
  }
}
