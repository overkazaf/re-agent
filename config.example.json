{
  "name": "0xAF-Re",
  "plannerProvider": "codex-sol",
  "executorProvider": "ds",
  "researcherProvider": "gemini-4-carbon",
  "defaultRole": "auto",
  "maxTurns": 8,
  "compactionStrategy": "summary",
  "auditProvider": "glm-5.3",
  "providers": {
    "codex-sol": {
      "type": "openai-responses",
      "label": "Codex Sol (Planner / Auditor)",
      "model": "codex-sol",
      "baseUrl": "https://api.openai.com/v1",
      "apiKeyEnv": ["OPENAI_API_KEY", "OPENAI_CODEX_OAUTH_TOKEN"],
      "reasoningEffort": "high"
    },
    "gemini-4-carbon": {
      "type": "openai-chat",
      "label": "Gemini 4 Carbon (Planner / Auditor)",
      "model": "gemini-4-carbon",
      "baseUrl": "https://generativelanguage.googleapis.com/v1beta/openai",
      "apiKeyEnv": ["GEMINI_API_KEY", "GOOGLE_API_KEY"],
      "maxTokens": 8192
    },
    "ds": {
      "type": "openai-chat",
      "label": "DeepSeek / DS (Executor)",
      "model": "deepseek-chat",
      "baseUrl": "https://api.deepseek.com/v1",
      "apiKeyEnv": ["DEEPSEEK_API_KEY"],
      "maxTokens": 8192
    },
    "gemini-4-neon": {
      "type": "openai-chat",
      "label": "Gemini 4 Neon (Fast Executor)",
      "model": "gemini-4-neon",
      "baseUrl": "https://generativelanguage.googleapis.com/v1beta/openai",
      "apiKeyEnv": ["GEMINI_API_KEY", "GOOGLE_API_KEY"],
      "maxTokens": 8192
    },
    "glm-5.3-flash": {
      "type": "openai-chat",
      "label": "GLM-5.3-Flash (Fast Executor)",
      "model": "glm-5.3-flash",
      "baseUrl": "https://open.bigmodel.cn/api/paas/v4",
      "apiKeyEnv": ["ZAI_API_KEY", "GLM_API_KEY"],
      "maxTokens": 8192
    },
    "glm-5.3": {
      "type": "openai-chat",
      "label": "GLM-5.3 (Isolated Auditor)",
      "model": "glm-5.3",
      "baseUrl": "https://open.bigmodel.cn/api/paas/v4",
      "apiKeyEnv": ["ZAI_API_KEY", "GLM_API_KEY"],
      "maxTokens": 8192
    },
    "codex": {
      "type": "cli-tmux",
      "label": "Codex CLI tmux",
      "model": "codex-cli",
      "cliCommand": "codex",
      "cliArgs": [
        "exec",
        "--json",
        "--skip-git-repo-check",
        "--sandbox",
        "read-only",
        "--output-last-message",
        "{output}",
        "-"
      ],
      "cliTimeoutMs": 600000,
      "cliUnsetEnv": ["OPENAI_API_KEY"]
    },
    "claude": {
      "type": "cli-tmux",
      "label": "Claude Code tmux",
      "model": "claude-code-cli",
      "cliCommand": "claude",
      "cliArgs": [
        "-p",
        "--output-format",
        "stream-json",
        "--verbose",
        "--include-partial-messages",
        "--permission-mode",
        "default"
      ],
      "cliTimeoutMs": 600000,
      "cliUnsetEnv": ["ANTHROPIC_API_KEY", "ANTHROPIC_OAUTH_TOKEN"],
      "cliResumeSession": true
    },
    "codex-api": {
      "type": "openai-responses",
      "label": "Codex API",
      "model": "gpt-5.3-codex",
      "baseUrl": "https://api.openai.com/v1",
      "apiKeyEnv": ["OPENAI_API_KEY", "OPENAI_CODEX_OAUTH_TOKEN"],
      "reasoningEffort": "high"
    },
    "claude-api": {
      "type": "anthropic",
      "label": "Claude API Opus 4.8",
      "model": "claude-opus-4-8",
      "baseUrl": "https://api.anthropic.com",
      "apiKeyEnv": ["ANTHROPIC_API_KEY", "ANTHROPIC_OAUTH_TOKEN"],
      "maxTokens": 8192
    },
    "grok": {
      "type": "openai-responses",
      "label": "Grok Build 4.5",
      "model": "grok-4.5",
      "baseUrl": "https://api.x.ai/v1",
      "apiKeyEnv": ["XAI_API_KEY"],
      "reasoningEffort": "high",
      "maxTokens": 8192
    },
    "grok-cli": {
      "type": "cli-tmux",
      "label": "Grok Build CLI tmux",
      "model": "grok-build-cli",
      "cliCommand": "grok",
      "cliArgs": [
        "--prompt-file",
        "{prompt}",
        "--output-format",
        "plain",
        "--disable-web-search",
        "--no-memory",
        "--permission-mode",
        "dontAsk"
      ],
      "cliTimeoutMs": 600000,
      "cliPromptMaxChars": 80000,
      "cliResumeSession": true
    },
    "deepseek": {
      "type": "openai-chat",
      "label": "DeepSeek",
      "model": "deepseek-chat",
      "baseUrl": "https://api.deepseek.com/v1",
      "apiKeyEnv": ["DEEPSEEK_API_KEY"],
      "maxTokens": 8192
    },
    "glm": {
      "type": "openai-chat",
      "label": "GLM / Z.AI",
      "model": "glm-4.6",
      "baseUrl": "https://open.bigmodel.cn/api/paas/v4",
      "apiKeyEnv": ["ZAI_API_KEY", "GLM_API_KEY"],
      "maxTokens": 8192
    },
    "mock": {
      "type": "mock",
      "label": "Mock Provider",
      "model": "mock-reasoner"
    }
  },
  "mcpServers": {
    "ida": {
      "command": "python3",
      "args": ["-m", "ida_pro_mcp.server"],
      "timeoutMs": 120000,
      "disabled": true
    }
  }
}
